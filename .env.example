# ---- Required ----
DISCORD_TOKEN=paste-your-discord-bot-token

# ---- Optional ----
# Register slash commands on one server only (instant, handy while testing). Leave empty for global.
DEV_GUILD_ID=
# Your Discord user ID: allowed to run /scorebot update
OWNER_USER_ID=
# Where the database and downloaded nflverse data live
DB_PATH=/opt/scorebot/data/scorebot.db
# Time zone for schedules and the weekly preview
TZ_DISPLAY=America/New_York
# Weekly preview: weekday (0=Mon … 6=Sun) and local hour; DIGEST_HOUR=-1 turns it off
DIGEST_WEEKDAY=1
DIGEST_HOUR=10
LOG_LEVEL=INFO
